.navigation/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/

# NDK
obj/

# IntelliJ IDEA artifacts
*.iml
*.ipr
*.iws
.idea/

# Generated files
gen/
out/

# Debug symbols
*.so
*.dylib
*.dll

# Coverage reports
coverage/
*.ec

# APK Analyzer
apkanalyzer/

# Android Coverage
*.coveragedata

# Bundle tool temporary folder
.bundles/

# Android device logs
adb.log

# Keystore files
*.keystore
*.jks

# Environment files
.env
.env.local
*.env*

# Temporary files
*.tmp
*.temp
*.swp

# OS generated files
.DS_Store
Thumbs.db
```